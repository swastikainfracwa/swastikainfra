# NextAuth Configuration
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:8080

# Supabase Configuration
# 1. Create a Supabase project at https://app.supabase.com
# 2. Go to Project Settings > API
# 3. Copy your project URL and anon key below

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gmail SMTP Configuration
# Create a Google App Password with 2-factor authentication enabled
# Use smtp.gmail.com with your Gmail address and app password


# Service Role Key (ONLY for data migration script)
# ⚠️ NEVER commit this to git or expose in client code
# Only needed once to run: npm run migrate:data
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site URL for OAuth redirects
# Production: https://yourdomain.com
# Development: http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:8080

# Google Maps API Key
# Get your API key from: https://console.cloud.google.com/google/maps-apis/
# Required APIs: Maps JavaScript API, Places API, Geocoding API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Setup Instructions:
# 1. Copy this file to .env.local
# 2. Generate NextAuth secret: openssl rand -base64 32 (or use any random 32-character string)
# 3. Fill in your Supabase credentials
# 4. Get Google Maps API key (see GOOGLE_MAPS_SETUP.md for detailed instructions)
# 5. Run database migrations in Supabase SQL Editor:
#    - First run: supabase/migrations/20260207_initial_schema.sql
#    - Then run: supabase/migrations/20260209_add_password_hash.sql
# 6. Start development server: bun run dev
